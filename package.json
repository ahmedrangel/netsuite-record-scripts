{
  "name": "netsuite-record-scripts",
  "title": "NetSuite Record Scripts",
  "description": "Instantly view all scripts deployed on a NetSuite Record or Suitelet with just one click!",
  "private": true,
  "version": "0.3.7",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Ahmed Rangel",
    "email": "ahmedrangel@outlook.com",
    "url": "https://ahmedrangel.com"
  },
  "homepage": "https://github.com/ahmedrangel/netsuite-record-scripts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedrangel/netsuite-record-scripts.git"
  },
  "bugs": "https://github.com/ahmedrangel/netsuite-record-scripts/issues",
  "scripts": {
    "dev": "wxt --config .config/wxt.ts",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "vue-tsc --noEmit",
    "postinstall": "wxt prepare",
    "lint": "eslint . --config .config/eslint.mjs",
    "test:types": "tsc --noEmit",
    "release": "node --run checks && changelogen --release --no-github && git push --follow-tags",
    "release:github": "changelogen gh release",
    "cleaninstall": "rmdir /s/q node_modules && del /f/q pnpm-lock.yaml && pnpm install"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "@iconify/vue": "^5.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "cheerio": "^1.2.0",
    "ofetch": "^1.5.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@btonasse/suitescript-types": "^2.4.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chrome": "^0.2.6",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-vue": "^1.0.3",
    "changelogen": "^0.6.2",
    "eslint": "^10.8.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.10.0",
    "iconify-browser-cache": "^0.4.0",
    "typescript": "6.0.3",
    "ufo": "^1.6.4",
    "vue-tsc": "^3.3.10",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4"
  },
  "packageManager": "pnpm@11.22.0"
}
